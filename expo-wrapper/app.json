{
  "expo": {
    "name": "Sparkling Silver",
    "owner": "sujalshah07s-team",
    "slug": "sparling-silver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#6D1F2E",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sparklingsilver.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is used to scan product barcodes and QR codes in the admin catalogue tools.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleDisplayName": "Sparkling Silver",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "instagram",
          "tel",
          "mailto",
          "https"
        ],
        "NSUserNotificationsUsageDescription": "Notifications keep you updated on your order status, dispatch and new collection launches."
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.sparklingsilver.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "useNextNotificationsApi": true,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "417fc100-3d56-45d9-9208-01dd5c241e31"
      }
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#6D1F2E",
      "iosDisplayInForeground": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#6D1F2E",
          "mode": "production"
        }
      ],
      "expo-screen-capture",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.1.12297006",
            "minifyEnabled": true,
            "shrinkResources": true
          }
        }
      ]
    ]
  }
}
